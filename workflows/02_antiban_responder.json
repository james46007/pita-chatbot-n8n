{
  "id": "PitaAntibanWf002",
  "name": "02_antiban_responder",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Entrada Sub-Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        180,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Extraer y sanitizar teléfono\nconst remoteJid = input.remoteJid || '';\nconst cleanPhone = remoteJid.split('@')[0].replace(/\\D/g, '');\n\n// Configuración de Anti-baneo desde variables de entorno o defaults\nconst minRead = parseInt($env.ANTIBAN_MIN_READ_DELAY_MS || '1500', 10);\nconst maxRead = parseInt($env.ANTIBAN_MAX_READ_DELAY_MS || '3500', 10);\nconst msPerChar = parseInt($env.ANTIBAN_MS_PER_CHAR || '35', 10);\nconst minTyping = parseInt($env.ANTIBAN_MIN_TYPING_MS || '2000', 10);\nconst maxTyping = parseInt($env.ANTIBAN_MAX_TYPING_MS || '7000', 10);\n\n// 1. Simulación de delay de lectura (humano leyendo el mensaje que le llegó)\nconst readDelayMs = Math.floor(Math.random() * (maxRead - minRead + 1)) + minRead;\nconst readDelaySeconds = Math.max(1, Math.round(readDelayMs / 1000));\n\nreturn {\n  json: {\n    ...input,\n    cleanPhone,\n    readDelayMs,\n    readDelaySeconds,\n    msPerChar,\n    minTyping,\n    maxTyping\n  }\n};"
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Calcular Delays Anti-Baneo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.readDelaySeconds || Math.max(1, Math.round(($json.readDelayMs || 2000) / 1000)) }}",
        "unit": "seconds"
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "Delay Lectura (Reading Delay)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        620,
        300
      ],
      "webhookId": "read-delay-wait"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/chat/sendPresence/{{ $json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_GLOBAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $json.cleanPhone, presence: 'composing', delay: 1200 } }}",
        "options": {}
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Enviar Presencia: 'Escribiendo...'",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        180
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "PitaReservasWf03",
          "mode": "id"
        },
        "workflowInputs": {
          "mappingMode": "passthrough"
        }
      },
      "id": "a5555555-5555-5555-5555-555555555555",
      "name": "Procesar Lógica de Negocio (Pita API)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst replyText = input.replyText || '¡Hola! ¿En qué horario deseas reservar tu cancha?';\nconst cleanPhone = input.cleanPhone || (input.remoteJid ? input.remoteJid.split('@')[0].replace(/\\D/g, '') : '');\n\nconst msPerChar = parseInt(input.msPerChar || $env.ANTIBAN_MS_PER_CHAR || '35', 10);\nconst minTyping = parseInt(input.minTyping || $env.ANTIBAN_MIN_TYPING_MS || '2000', 10);\nconst maxTyping = parseInt(input.maxTyping || $env.ANTIBAN_MAX_TYPING_MS || '7000', 10);\n\nconst calculatedTyping = replyText.length * msPerChar;\nconst jitter = Math.floor(Math.random() * 800) - 400;\nconst typingDelayMs = Math.min(maxTyping, Math.max(minTyping, calculatedTyping + jitter));\nconst typingDelaySeconds = Math.max(1, Math.round(typingDelayMs / 1000));\n\nreturn {\n  json: {\n    ...input,\n    cleanPhone,\n    replyText,\n    typingDelayMs,\n    typingDelaySeconds\n  }\n};"
      },
      "id": "a6666666-6666-6666-6666-666666666666",
      "name": "Calcular Typing Delay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        300
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.typingDelaySeconds || Math.max(1, Math.round(($json.typingDelayMs || 3000) / 1000)) }}",
        "unit": "seconds"
      },
      "id": "a7777777-7777-7777-7777-777777777777",
