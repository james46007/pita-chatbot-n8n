{
  "id": "PitaReservasWf03",
  "name": "03_reservas_handler",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b1111111-1111-1111-1111-111111111111",
      "name": "Entrada Handler Negocio",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PITA_API_BASE_URL }}/api/bot/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PITA_BOT_SECRET_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { instance: $json.instance, phone: ($json.remoteJid || '').split('@')[0], pushName: $json.pushName, text: $json.messageText, listRowId: $json.listRowId || null, isImage: !!$json.isImage } }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Chat IA en Pita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        300
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json || {};\nconst triggerData = $('Entrada Handler Negocio').first().json;\n\nconst shouldReply = res.shouldReply === true && (!!res.replyText || !!res.interactive);\n\nreturn {\n  json: {\n    ...triggerData,\n    shouldReply,\n    replyText: res.replyText || '',\n    interactive: res.interactive || null\n  }\n};"
      },
      "id": "b3333333-3333-3333-3333-333333333333",
      "name": "Armar Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        300
      ]
    }
  ],
  "connections": {
    "Entrada Handler Negocio": {
      "main": [
        [
          {
            "node": "Chat IA en Pita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat IA en Pita": {
      "main": [
        [
          {
            "node": "Armar Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
