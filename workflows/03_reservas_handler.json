{
  "id": "PitaReservasWf03",
  "name": "03_reservas_handler",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "b1111111-1111-1111-1111-111111111111",
      "name": "Entrada Handler Negocio",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isImage }}",
              "value2": true
            }
          ],
          "string": [
            {
              "value1": "={{ $json.mediaBase64 }}",
              "operation": "isEmpty"
            }
          ]
        }
      },
      "id": "c3333333-3333-3333-3333-333333333333",
      "name": "¿Tiene Imagen Sin Base64?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        420,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_API_URL }}/message/downloadMedia/{{ $json.instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.EVOLUTION_GLOBAL_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: $json.rawMessage || { key: { id: $json.messageId } }, convertToMp4: false } }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "c4444444-4444-4444-4444-444444444444",
      "name": "Descargar Media Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        200
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const mediaRes = $input.first().json || {};\nconst triggerData = $('Entrada Handler Negocio').first().json;\n\nlet downloadedBase64 = mediaRes.base64 || mediaRes.data?.base64 || '';\nif (downloadedBase64 && !downloadedBase64.startsWith('data:')) {\n  const mimetype = mediaRes.mimetype || 'image/jpeg';\n  downloadedBase64 = `data:${mimetype};base64,${downloadedBase64}`;\n}\n\nreturn {\n  json: {\n    ...triggerData,\n    mediaBase64: downloadedBase64 || triggerData.mediaBase64 || null\n  }\n};"
      },
      "id": "c5555555-5555-5555-5555-555555555555",
      "name": "Normalizar Base64 Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PITA_API_BASE_URL }}/api/bot/chat",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PITA_BOT_SECRET_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { instance: $json.instance, phone: ($json.remoteJid || '').split('@')[0], pushName: $json.pushName, text: $json.messageText, listRowId: $json.listRowId || null, isImage: !!$json.isImage, messageId: $json.messageId || null, mediaBase64: $json.mediaBase64 || null } }}",
        "options": {
          "timeout": 45000
        }
      },
      "id": "b2222222-2222-2222-2222-222222222222",
      "name": "Chat IA en Pita",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": false
    },
    {
      "parameters": {
        "jsCode": "const res = $input.first().json || {};\nconst triggerData = $('Entrada Handler Negocio').first().json;\n\nconst shouldReply = res.shouldReply === true && (!!res.replyText || !!res.interactive);\n\nreturn {\n  json: {\n    ...triggerData,\n    shouldReply,\n    replyText: res.replyText || '',\n    interactive: res.interactive || null\n  }\n};"
      },
      "id": "b3333333-3333-3333-3333-333333333333",
      "name": "Armar Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ]
    }
  ],
  "connections": {
    "Entrada Handler Negocio": {
      "main": [
        [
          {
            "node": "¿Tiene Imagen Sin Base64?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Tiene Imagen Sin Base64?": {
      "main": [
        [
          {
            "node": "Descargar Media Evolution",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Chat IA en Pita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Descargar Media Evolution": {
      "main": [
        [
          {
            "node": "Normalizar Base64 Media",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalizar Base64 Media": {
      "main": [
        [
          {
            "node": "Chat IA en Pita",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Chat IA en Pita": {
      "main": [
        [
          {
            "node": "Armar Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
