        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isConnectionUpdate }}",
              "value2": true
            }
          ]
        }
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "¿Es Connection Update?",
