{
  "id": "PitaCronScheduler04",
  "name": "04_cron_scheduler",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "e1111111-1111-1111-1111-111111111111",
      "name": "Temporizador cada 10 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.PITA_API_BASE_URL || 'https://pitaapp.vercel.app').replace(/\\/$/, '') }}/api/cron/recordatorios",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PITA_BOT_SECRET_KEY || $env.CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "e2222222-2222-2222-2222-222222222222",
      "name": "1. Disparar Recordatorios de Partido",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.PITA_API_BASE_URL || 'https://pitaapp.vercel.app').replace(/\\/$/, '') }}/api/cron/avisos-pago",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PITA_BOT_SECRET_KEY || $env.CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "e3333333-3333-3333-3333-333333333333",
      "name": "2. Disparar Avisos de Pago por Vencer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.PITA_API_BASE_URL || 'https://pitaapp.vercel.app').replace(/\\/$/, '') }}/api/cron/whatsapp-queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.PITA_BOT_SECRET_KEY || $env.CRON_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "e4444444-4444-4444-4444-444444444444",
      "name": "3. Procesar Cola WhatsApp Pendiente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Temporizador cada 10 Minutos": {
      "main": [
        [
          {
            "node": "1. Disparar Recordatorios de Partido",
            "type": "main",
            "index": 0
          },
          {
            "node": "2. Disparar Avisos de Pago por Vencer",
            "type": "main",
            "index": 0
          },
          {
            "node": "3. Procesar Cola WhatsApp Pendiente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
