# ==========================================
# Configuración del Chatbot n8n Multitenant
# ==========================================

# Puerto de n8n
N8N_PORT=5678

# Clave de encriptación de n8n (Mínimo 32 caracteres obligatorios)
N8N_ENCRYPTION_KEY=reemplazar_con_hash_seguro_de_32_caracteres_o_mas

# Zona Horaria
GENERIC_TIMEZONE=America/Lima
TZ=America/Lima

# URL pública de n8n (para Webhooks de Evolution API)
WEBHOOK_URL=https://bot.tudominio.com/
N8N_EDITOR_BASE_URL=https://bot.tudominio.com/

# Integración con el Sistema Central Pita
PITA_API_BASE_URL=https://pita.tudominio.com
PITA_BOT_SECRET_KEY=clave_secreta_compartida_con_backend_pita

# Integración con Evolution API
EVOLUTION_API_URL=https://evolution.tudominio.com
EVOLUTION_GLOBAL_KEY=clave_global_de_evolution_api

# Configuración Anti-baneo
# Rango aleatorio de espera inicial antes de simular presencia (milisegundos)
ANTIBAN_MIN_READ_DELAY_MS=1500
ANTIBAN_MAX_READ_DELAY_MS=3500

# Milisegundos de 'composing' simulado por cada caracter de respuesta
ANTIBAN_MS_PER_CHAR=35

# Límites de tiempo simulando 'escribiendo...'
ANTIBAN_MIN_TYPING_MS=2000
ANTIBAN_MAX_TYPING_MS=7000
